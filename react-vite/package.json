{
  "name": "react-login",
  "version": "1.0.0",
  "private": true,
  "description": "React login form with Express + MongoDB",
  "scripts": {
    "postinstall": "npm install --prefix client",
    "dev": "concurrently -n server,client -c blue,green \"node --watch server/server.js\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
